<mujoco model="scene_go2_room_stairs">
  <compiler angle="radian" meshdir="assets" autolimits="true" />
  <option cone="elliptic" impratio="10" iterations="10" ls_iterations="20" ccd_iterations="50" />

  <include file="go2_depth_deploy.xml" />

  <asset>
    <texture type="skybox" builtin="flat" rgb1="0 0 0" rgb2="0 0 0" width="512" height="3072" />
    <texture type="2d" name="room_floor_tex" builtin="checker" mark="edge"
      rgb1="0.22 0.27 0.25" rgb2="0.12 0.16 0.15" markrgb="0.75 0.75 0.7"
      width="300" height="300" />
    <material name="room_floor" texture="room_floor_tex" texuniform="true" texrepeat="8 8" reflectance="0.15" />
    <material name="room_wall" rgba="0.35 0.37 0.38 1" />
    <material name="room_stair" rgba="0.42 0.45 0.40 1" />
  </asset>

  <worldbody>
    <light pos="0 0 6" dir="0 0 -1" type="directional" />

    <body name="room">
      <!-- 20 m x 20 m enclosed room: x/y range is -10 to 10. -->
      <geom name="room_floor" type="box" pos="0 0 -0.025" size="10 10 0.025"
        material="room_floor" group="0" friction="0.8 0.02 0.01" />
      <!-- <geom name="room_wall_pos_x" type="box" pos="10 0 0.75" size="0.1 10 3.0"
        material="room_wall" group="1" friction="0.8 0.02 0.01" />
      <geom name="room_wall_pos_y" type="box" pos="0 10 0.75" size="10 0.1 3.0"
        material="room_wall" group="1" friction="0.8 0.02 0.01" />
      <geom name="room_wall_neg_y" type="box" pos="0 -10 0.75" size="10 0.1 3.0"
        material="room_wall" group="1" friction="0.8 0.02 0.01" /> -->
      <!-- <geom name="room_ceiling" type="box" pos="0 0 3.0" size="10 10 0.05"
        material="room_wall" group="1" friction="0.8 0.02 0.01" /> -->
    </body>

    <body name="stairs">
      <!-- Ten ascending steps in front of the spawn point. Step height is 0.15 m. -->
      <geom name="room_stair_01" type="box" pos="-2.35 0 0.075" size="0.15 2.0 0.075"
        material="room_stair" group="0" friction="0.8 0.02 0.01" />
      <geom name="room_stair_02" type="box" pos="-2.05 0 0.150" size="0.15 2.0 0.150"
        material="room_stair" group="0" friction="0.8 0.02 0.01" />
      <geom name="room_stair_03" type="box" pos="-1.75 0 0.225" size="0.15 2.0 0.225"
        material="room_stair" group="0" friction="0.8 0.02 0.01" />
      <geom name="room_stair_04" type="box" pos="-1.45 0 0.300" size="0.15 2.0 0.300"
        material="room_stair" group="0" friction="0.8 0.02 0.01" />
      <geom name="room_stair_05" type="box" pos="-1.15 0 0.375" size="0.15 2.0 0.375"
        material="room_stair" group="0" friction="0.8 0.02 0.01" />
      <geom name="room_stair_06" type="box" pos="-0.85 0 0.450" size="0.15 2.0 0.450"
        material="room_stair" group="0" friction="0.8 0.02 0.01" />
      <geom name="room_stair_07" type="box" pos="-0.55 0 0.525" size="0.15 2.0 0.525"
        material="room_stair" group="0" friction="0.8 0.02 0.01" />
      <geom name="room_stair_08" type="box" pos="-0.25 0 0.600" size="0.15 2.0 0.600"
        material="room_stair" group="0" friction="0.8 0.02 0.01" />
      <geom name="room_stair_09" type="box" pos="0.05 0 0.675" size="0.15 2.0 0.675"
        material="room_stair" group="0" friction="0.8 0.02 0.01" />
      <geom name="room_stair_10" type="box" pos="0.35 0 0.750" size="0.15 2.0 0.750"
        material="room_stair" group="0" friction="0.8 0.02 0.01" />
      <geom name="room_stair_top_platform" type="box" pos="2.50 0 0.750" size="2.0 2.0 0.750"
        material="room_stair" group="0" friction="0.8 0.02 0.01" />
    </body>

    <body name="waypoint_markers">
      <geom name="wp_0" type="sphere" pos="-4.5 0 0.08" size="0.08" group="5" rgba="1 0 0 1" contype="0" conaffinity="0" />
      <geom name="wp_1" type="sphere" pos="-2.5 0 0.08" size="0.08" group="5" rgba="1 0.5 0 1" contype="0" conaffinity="0" />
      <geom name="wp_2" type="sphere" pos="-1.3 0 0.38" size="0.08" group="5" rgba="1 1 0 1" contype="0" conaffinity="0" />
      <geom name="wp_3" type="sphere" pos="-0.1 0 0.98" size="0.08" group="5" rgba="0 1 0 1" contype="0" conaffinity="0" />
      <geom name="wp_4" type="sphere" pos="1.2 0 1.58" size="0.08" group="5" rgba="0 1 1 1" contype="0" conaffinity="0" />
      <geom name="wp_5" type="sphere" pos="3.0 0 1.58" size="0.08" group="5" rgba="0 0.4 1 1" contype="0" conaffinity="0" />
    </body>
  </worldbody>

  <keyframe>
    <key name="home" qpos="-6 0 0.445 1 0 0 0 0 0.9 -1.8 0 0.9 -1.8 0 0.9 -1.8 0 0.9 -1.8"
      ctrl="0 0.9 -1.8 0 0.9 -1.8 0 0.9 -1.8 0 0.9 -1.8" />
  </keyframe>

  <statistic center="0 0 0.75" extent="12.0" />
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0.9 0.9 0.9" />
    <rgba haze="0.15 0.25 0.35 1" />
    <global azimuth="-140" elevation="-20" />
  </visual>
</mujoco>
